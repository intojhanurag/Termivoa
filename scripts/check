#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

node_major=$(node -p "process.versions.node.split('.')[0]")
if [ "$node_major" != "24" ]; then
  echo "Termivoa checks require Node 24; run 'nvm use 24.11.0'." >&2
  exit 1
fi

export GOTOOLCHAIN=go1.27.1
pnpm protocol:check

if ! unformatted=$(gofmt -l cmd internal tests third_party/ansi third_party/vt third_party/xpty third_party/ultraviolet); then
  echo "gofmt failed; install Go and put gofmt on PATH." >&2
  exit 1
fi
if [ -n "$unformatted" ]; then
  echo "Go files require formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./...
go test ./...
(cd third_party/ansi && go test ./...)
(cd third_party/vt && go test ./...)
(cd third_party/xpty && go test ./...)
go test github.com/charmbracelet/ultraviolet/...
pnpm typecheck
pnpm test:web
pnpm build:web
