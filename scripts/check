#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

node_major=$(node -p "process.versions.node.split('.')[0]")
if [ "$node_major" != "24" ]; then
  echo "Termivoa checks require Node 24; run 'nvm use 24.11.0'." >&2
  exit 1
fi

if ! command -v gofmt >/dev/null 2>&1; then
  echo "gofmt is not on PATH; install Go and put its bin directory on PATH." >&2
  exit 1
fi

pnpm protocol:generate
git diff --exit-code -- internal/protocol/generated.go web/src/generated/protocol.ts

if ! cmp -s plan.md docs/implementation-plan.md; then
  echo "docs/implementation-plan.md must be an exact copy of plan.md." >&2
  exit 1
fi

if ! unformatted=$(find cmd internal tests third_party/ansi third_party/vt third_party/xpty third_party/ultraviolet -name '*.go' -type f -print 2>/dev/null | xargs gofmt -l); then
  echo "gofmt failed; see the errors above." >&2
  exit 1
fi
if [ -n "$unformatted" ]; then
  echo "Go files require formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi

GOTOOLCHAIN=go1.27.1 go vet ./...
GOTOOLCHAIN=go1.27.1 go test ./...
(cd third_party/ansi && GOTOOLCHAIN=go1.27.1 go test ./...)
(cd third_party/vt && GOTOOLCHAIN=go1.27.1 go test ./...)
(cd third_party/xpty && GOTOOLCHAIN=go1.27.1 go test ./...)
GOTOOLCHAIN=go1.27.1 go test github.com/charmbracelet/ultraviolet/...
pnpm typecheck
pnpm test:web
pnpm build:web
