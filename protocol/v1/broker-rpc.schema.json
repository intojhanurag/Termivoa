{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-terminal.invalid/protocol/v1/broker-rpc.schema.json",
  "title": "BrokerRPCMessage",
  "description": "Canonical bounded session-management RPC carried after the local IPC handshake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "requestId", "payload"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "type": { "$ref": "#/$defs/messageType" },
    "requestId": { "$ref": "#/$defs/uuid" },
    "sessionId": { "$ref": "#/$defs/uuid" },
    "generation": { "$ref": "#/$defs/uuid" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/sessionListRequestMessage" },
    { "$ref": "#/$defs/sessionCreateRequestMessage" },
    { "$ref": "#/$defs/sessionRenameRequestMessage" },
    { "$ref": "#/$defs/sessionTerminateRequestMessage" },
    { "$ref": "#/$defs/sessionStatusRequestMessage" },
    { "$ref": "#/$defs/sessionListResultMessage" },
    { "$ref": "#/$defs/sessionCreateResultMessage" },
    { "$ref": "#/$defs/sessionRenameResultMessage" },
    { "$ref": "#/$defs/sessionTerminateResultMessage" },
    { "$ref": "#/$defs/sessionStatusResultMessage" },
    { "$ref": "#/$defs/errorMessage" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionIdentity": {
      "type": "object",
      "required": ["sessionId", "generation"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/uuid" }
      }
    },
    "noSessionIdentity": {
      "type": "object",
      "properties": {
        "sessionId": false,
        "generation": false
      }
    },
    "optionalSessionIdentity": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/sessionIdentity" },
        { "$ref": "#/$defs/noSessionIdentity" }
      ]
    },
    "messageType": {
      "title": "BrokerRPCMessageType",
      "type": "string",
      "enum": [
        "session.list.request", "session.create.request", "session.rename.request",
        "session.terminate.request", "session.status.request", "session.list.result",
        "session.create.result", "session.rename.result", "session.terminate.result",
        "session.status.result", "broker.error"
      ]
    },
    "emptyPayload": {
      "title": "BrokerRPCEmptyPayload",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "sessionListRequestPayload": {
      "title": "BrokerRPCSessionListRequestPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "cursor": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "sessionCreateRequestPayload": {
      "title": "BrokerRPCSessionCreateRequestPayload",
      "description": "References broker-saved configuration only. Executable paths, arguments, workdirs and environment values are deliberately absent. With worktree, the broker first creates a git worktree and starts the session there (see worktreeCreate).",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "projectId", "shellProfileId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "shellProfileId": { "$ref": "#/$defs/uuid" },
        "worktree": { "$ref": "#/$defs/worktreeCreate" }
      }
    },
    "worktreeName": {
      "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "worktreeCreate": {
      "title": "WorktreeCreate",
      "description": "Creates a git worktree for the new session. The broker reads the folder of the live session sourceSessionId (as changes.list does), finds its main repository root, checks that base is a branch from a fresh branches listing, and runs git worktree add -b termivoa/<name> <home>/termivoa/worktrees/<repo>/<name> <base> without upstream tracking. The session starts in that folder with name as its title. worktree_exists: the folder or the branch already exists. not_a_repository: the source folder is not in a git repository. limit_exceeded: the repository already has 50 worktrees there. A replayed operationId never creates a second worktree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSessionId", "name", "base"],
      "properties": {
        "sourceSessionId": { "$ref": "#/$defs/uuid" },
        "name": { "$ref": "#/$defs/worktreeName" },
        "base": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sessionWorktree": {
      "title": "SessionWorktree",
      "description": "Present when the folder the session started in is a Termivoa worktree, <home>/termivoa/worktrees/<repo>/<name>. Only such a session accepts worktree.remove.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo"],
      "properties": {
        "name": { "$ref": "#/$defs/worktreeName" },
        "repo": { "type": "string", "minLength": 1, "maxLength": 128, "maxUtf8Bytes": 384, "safeDisplayText": true }
      }
    },
    "sessionRenameRequestPayload": {
      "title": "BrokerRPCSessionRenameRequestPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "title"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "title": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "maxUtf8Bytes": 128, "safeDisplayText": true
        }
      }
    },
    "sessionTerminateRequestPayload": {
      "title": "BrokerRPCSessionTerminateRequestPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" }
      }
    },
    "sessionRecord": {
      "title": "BrokerRPCSessionRecord",
      "description": "controlled and viewerCount are live presence computed by the broker at request time and are absent when the session is not live. controllerIsYou is set only on the browser gateway list, for the requesting device. Lease secrets, connection IDs and other device labels are never included. titleIsCustom is true when a user renamed the session; clients show the basename of cwd (the live folder) as the title only when it is absent or false. cwd is present only while the session is running. worktree is present only while the session is live in this broker and started in a Termivoa worktree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "generation", "title", "projectId", "shellProfileId", "state",
        "columns", "rows", "createdAt", "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/uuid" },
        "title": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "maxUtf8Bytes": 256, "pattern": "^[^\\u0000]+$"
        },
        "projectId": { "$ref": "#/$defs/uuid" },
        "shellProfileId": { "$ref": "#/$defs/uuid" },
        "state": { "$ref": "envelope.schema.json#/$defs/sessionLifecycle" },
        "columns": { "type": "integer", "minimum": 20, "maximum": 400 },
        "rows": { "type": "integer", "minimum": 5, "maximum": 200 },
        "createdAt": { "type": "string", "minLength": 20, "maxLength": 35 },
        "updatedAt": { "type": "string", "minLength": 20, "maxLength": 35 },
        "startedAt": { "type": "string", "minLength": 20, "maxLength": 35 },
        "endedAt": { "type": "string", "minLength": 20, "maxLength": 35 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "controlled": { "type": "boolean" },
        "controllerIsYou": { "type": "boolean" },
        "viewerCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "lastOutputAt": { "type": "string", "minLength": 20, "maxLength": 35 },
        "preview": {
          "type": "string", "minLength": 1, "maxLength": 160,
          "maxUtf8Bytes": 480, "safeDisplayText": true
        },
        "agent": { "$ref": "envelope.schema.json#/$defs/agentStatus" },
        "previews": { "$ref": "envelope.schema.json#/$defs/previewPorts" },
        "cwd": { "$ref": "envelope.schema.json#/$defs/workingDirectory" },
        "titleIsCustom": { "type": "boolean" },
        "worktree": { "$ref": "#/$defs/sessionWorktree" }
      }
    },
    "sessionListResultPayload": {
      "title": "BrokerRPCSessionListResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/sessionRecord" } },
        "nextCursor": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "sessionResultPayload": {
      "title": "BrokerRPCSessionResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["session"],
      "properties": {
        "session": { "$ref": "#/$defs/sessionRecord" }
      }
    },
    "sessionMutationResultPayload": {
      "title": "BrokerRPCSessionMutationResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "session"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "session": { "$ref": "#/$defs/sessionRecord" }
      }
    },
    "errorPayload": {
      "title": "BrokerRPCErrorPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "envelope.schema.json#/$defs/errorCode" },
        "message": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "maxUtf8Bytes": 512, "safeDisplayText": true
        }
      }
    },
    "sessionListRequestMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/noSessionIdentity" }], "properties": { "type": { "const": "session.list.request" }, "payload": { "$ref": "#/$defs/sessionListRequestPayload" } } },
    "sessionCreateRequestMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/noSessionIdentity" }], "properties": { "type": { "const": "session.create.request" }, "payload": { "$ref": "#/$defs/sessionCreateRequestPayload" } } },
    "sessionRenameRequestMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.rename.request" }, "payload": { "$ref": "#/$defs/sessionRenameRequestPayload" } } },
    "sessionTerminateRequestMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.terminate.request" }, "payload": { "$ref": "#/$defs/sessionTerminateRequestPayload" } } },
    "sessionStatusRequestMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.status.request" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "sessionListResultMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/noSessionIdentity" }], "properties": { "type": { "const": "session.list.result" }, "payload": { "$ref": "#/$defs/sessionListResultPayload" } } },
    "sessionCreateResultMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/noSessionIdentity" }], "properties": { "type": { "const": "session.create.result" }, "payload": { "$ref": "#/$defs/sessionMutationResultPayload" } } },
    "sessionRenameResultMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.rename.result" }, "payload": { "$ref": "#/$defs/sessionMutationResultPayload" } } },
    "sessionTerminateResultMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.terminate.result" }, "payload": { "$ref": "#/$defs/sessionMutationResultPayload" } } },
    "sessionStatusResultMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/sessionIdentity" }], "properties": { "type": { "const": "session.status.result" }, "payload": { "$ref": "#/$defs/sessionResultPayload" } } },
    "errorMessage": { "type": "object", "allOf": [{ "$ref": "#/$defs/optionalSessionIdentity" }], "properties": { "type": { "const": "broker.error" }, "payload": { "$ref": "#/$defs/errorPayload" } } }
  }
}
