{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-terminal.invalid/protocol/v1/admin-rpc.schema.json",
  "title": "AdminRPCMessage",
  "description": "Bounded correlated local administration RPC. The broker accepts it only from an IPC peer that declared clientKind cli; gateways and browsers can never reach it. admin.gateway.stop is served only by the gateway's private control endpoint, never by the broker. See authentication-rpc.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "requestId", "payload"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "type": { "$ref": "#/$defs/messageType" },
    "requestId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/pairGrantMessage" },
    { "$ref": "#/$defs/pairPendingMessage" },
    { "$ref": "#/$defs/pairApproveMessage" },
    { "$ref": "#/$defs/deviceListMessage" },
    { "$ref": "#/$defs/deviceRevokeMessage" },
    { "$ref": "#/$defs/deviceRenameMessage" },
    { "$ref": "#/$defs/projectAddMessage" },
    { "$ref": "#/$defs/projectListMessage" },
    { "$ref": "#/$defs/profileListMessage" },
    { "$ref": "#/$defs/profileDetectMessage" },
    { "$ref": "#/$defs/configOriginMessage" },
    { "$ref": "#/$defs/shutdownMessage" },
    { "$ref": "#/$defs/gatewayStopMessage" },
    { "$ref": "#/$defs/deviceRevokeViaMessage" },
    { "$ref": "#/$defs/computersListMessage" },
    { "$ref": "#/$defs/computersRemoveMessage" },
    { "$ref": "#/$defs/pairOfferMessage" },
    { "$ref": "#/$defs/pairOfferEndMessage" },
    { "$ref": "#/$defs/pairGrantResultMessage" },
    { "$ref": "#/$defs/pairPendingResultMessage" },
    { "$ref": "#/$defs/pairApproveResultMessage" },
    { "$ref": "#/$defs/deviceListResultMessage" },
    { "$ref": "#/$defs/deviceRevokeResultMessage" },
    { "$ref": "#/$defs/deviceRenameResultMessage" },
    { "$ref": "#/$defs/projectAddResultMessage" },
    { "$ref": "#/$defs/projectListResultMessage" },
    { "$ref": "#/$defs/profileListResultMessage" },
    { "$ref": "#/$defs/profileDetectResultMessage" },
    { "$ref": "#/$defs/configOriginResultMessage" },
    { "$ref": "#/$defs/shutdownResultMessage" },
    { "$ref": "#/$defs/gatewayStopResultMessage" },
    { "$ref": "#/$defs/deviceRevokeViaResultMessage" },
    { "$ref": "#/$defs/computersListResultMessage" },
    { "$ref": "#/$defs/computersRemoveResultMessage" },
    { "$ref": "#/$defs/pairOfferResultMessage" },
    { "$ref": "#/$defs/pairOfferEndResultMessage" },
    { "$ref": "#/$defs/errorMessage" }
  ],
  "$defs": {
    "messageType": {
      "title": "AdminRPCMessageType",
      "type": "string",
      "enum": [
        "admin.pair.grant", "admin.pair.pending", "admin.pair.approve", "admin.device.list",
        "admin.device.revoke", "admin.project.add", "admin.project.list", "admin.profile.list",
        "admin.profile.detect", "admin.config.origin", "admin.shutdown", "admin.gateway.stop", "admin.device.rename",
        "admin.device.revoke.via", "admin.computers.list", "admin.computers.remove",
        "admin.pair.offer", "admin.pair.offer.end",
        "admin.pair.grant.result", "admin.pair.pending.result", "admin.pair.approve.result",
        "admin.device.list.result", "admin.device.revoke.result", "admin.project.add.result",
        "admin.project.list.result", "admin.profile.list.result", "admin.profile.detect.result",
        "admin.config.origin.result", "admin.shutdown.result", "admin.gateway.stop.result",
        "admin.device.rename.result", "admin.device.revoke.via.result", "admin.computers.list.result",
        "admin.computers.remove.result", "admin.pair.offer.result", "admin.pair.offer.end.result", "admin.error"
      ]
    },
    "timestamp": { "$ref": "http-api.schema.json#/$defs/timestamp" },
    "displayName": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "maxUtf8Bytes": 128, "safeDisplayText": true
    },
    "localPath": {
      "description": "A local filesystem path. Local administration only; never sent to a browser.",
      "type": "string", "minLength": 1, "maxLength": 4096, "maxUtf8Bytes": 4096
    },
    "origin": {
      "description": "Pairing link origin: https://host[:port], or http://127.0.0.1:port / http://localhost:port for development.",
      "type": "string", "minLength": 8, "maxLength": 512, "pattern": "^https?://[^/?#@\\s]+$"
    },
    "appOrigin": {
      "description": "The Termivoa app origin (the home computer) that a bound grant, pending pairing or device is bound to. Absent means this computer's own origin only.",
      "$ref": "http-api.schema.json#/$defs/computerOrigin"
    },
    "via": {
      "description": "pterm pair --via: a full app origin, or a short name that matches only the first label of a node's DNS name in this computer's own tailnet.",
      "anyOf": [
        { "$ref": "http-api.schema.json#/$defs/computerOrigin" },
        { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" }
      ]
    },
    "pairGrantPayload": {
      "title": "AdminRPCPairGrantPayload",
      "description": "Empty creates a grant for this computer's own origin. via binds the grant to one app origin, resolved by the broker in its own tailscale status and pinned to that node ID; allowTagged must be true when that node is tagged.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": { "$ref": "#/$defs/via" },
        "allowTagged": { "type": "boolean" }
      }
    },
    "pairGrantResultPayload": {
      "title": "AdminRPCPairGrantResultPayload",
      "description": "The only delivery of a fresh two-minute grant. origin is present when configured. appOrigin and appNode are present exactly when the grant is bound with via.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "expiresAt"],
      "properties": {
        "grant": { "$ref": "http-api.schema.json#/$defs/secret" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "origin": { "$ref": "#/$defs/origin" },
        "appOrigin": { "$ref": "#/$defs/appOrigin" },
        "appNode": { "$ref": "http-api.schema.json#/$defs/tailnetNode" }
      }
    },
    "pairOfferPayload": {
      "title": "AdminRPCPairOfferPayload",
      "description": "pterm pair --via (interactive wait only): offer this computer to the home computer via. The first call resolves via in a fresh tailscale status, pins that node and makes a bound grant; later calls with the same via re-send the same grant, or a new one when 60 s or less are left. allowTagged is not accepted: home drops every offer when either node is tagged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["via"],
      "properties": {
        "via": { "$ref": "#/$defs/via" }
      }
    },
    "pairOfferProblem": {
      "title": "AdminRPCPairOfferProblem",
      "description": "unreachable: no HTTP answer from home (or no usable address). busy: home answered 429 (its offer bucket is empty). not_accepted: any other answer than 204, for example a home without this feature.",
      "type": "string",
      "enum": ["unreachable", "busy", "not_accepted"]
    },
    "pairOfferResultPayload": {
      "title": "AdminRPCPairOfferResultPayload",
      "description": "The home the offer went to and when the offered grant expires. The grant itself is never in the result. delivered is true exactly when home answered 204; problem is present exactly when delivered is false.",
      "type": "object",
      "additionalProperties": false,
      "required": ["appOrigin", "appNode", "expiresAt", "delivered"],
      "properties": {
        "appOrigin": { "$ref": "#/$defs/appOrigin" },
        "appNode": { "$ref": "http-api.schema.json#/$defs/tailnetNode" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "delivered": { "type": "boolean" },
        "problem": { "$ref": "#/$defs/pairOfferProblem" }
      }
    },
    "pairOfferEndPayload": {
      "title": "AdminRPCPairOfferEndPayload",
      "description": "Ends the offer: deletes the offered grant and the given grant (the link's), each only when it was not redeemed, and clears the offer state.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grant": { "$ref": "http-api.schema.json#/$defs/secret" }
      }
    },
    "pendingPairing": {
      "title": "AdminRPCPendingPairing",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verificationCode", "deviceLabel", "expiresAt"],
      "properties": {
        "id": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "verificationCode": { "$ref": "http-api.schema.json#/$defs/verificationCode" },
        "deviceLabel": { "$ref": "http-api.schema.json#/$defs/deviceLabel" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "appOrigin": { "$ref": "#/$defs/appOrigin" },
        "appNode": { "$ref": "http-api.schema.json#/$defs/tailnetNode" }
      }
    },
    "pairPendingResultPayload": {
      "title": "AdminRPCPairPendingResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["pending"],
      "properties": {
        "pending": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/pendingPairing" } }
      }
    },
    "pendingIdPayload": {
      "title": "AdminRPCPendingIDPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingId"],
      "properties": { "pendingId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" } }
    },
    "deviceStatus": {
      "title": "AdminRPCDeviceStatus",
      "description": "active: not revoked, holding a credential that is unrevoked, before its absolute expiry, and used within the inactivity window. expired: not revoked, but no such credential. revoked: the device itself is revoked.",
      "type": "string",
      "enum": ["active", "expired", "revoked"]
    },
    "device": {
      "title": "AdminRPCDevice",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "revoked", "status", "createdAt", "lastUsedAt"],
      "properties": {
        "id": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "label": { "$ref": "http-api.schema.json#/$defs/deviceLabel" },
        "revoked": { "type": "boolean" },
        "status": { "$ref": "#/$defs/deviceStatus" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "lastUsedAt": { "$ref": "#/$defs/timestamp" },
        "appOrigin": { "$ref": "#/$defs/appOrigin" },
        "appNode": { "$ref": "http-api.schema.json#/$defs/tailnetNode" }
      }
    },
    "deviceRenamePayload": {
      "title": "AdminRPCDeviceRenamePayload",
      "description": "Sets a paired device's display label. The result echoes the saved values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "label"],
      "properties": {
        "deviceId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "label": { "$ref": "http-api.schema.json#/$defs/deviceLabel" }
      }
    },
    "deviceListResultPayload": {
      "title": "AdminRPCDeviceListResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["devices"],
      "properties": {
        "devices": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/device" } }
      }
    },
    "deviceIdPayload": {
      "title": "AdminRPCDeviceIDPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId"],
      "properties": { "deviceId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" } }
    },
    "deviceRevokeResultPayload": {
      "title": "AdminRPCDeviceRevokeResultPayload",
      "description": "Sent only after the revocation is durable and every bound live stream has been closed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "closedStreams"],
      "properties": {
        "deviceId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "closedStreams": { "type": "integer", "minimum": 0, "maximum": 65536 }
      }
    },
    "revokeViaPayload": {
      "title": "AdminRPCRevokeViaPayload",
      "description": "pterm revoke --via: revokes every device bound to appOrigin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["appOrigin"],
      "properties": { "appOrigin": { "$ref": "#/$defs/appOrigin" } }
    },
    "revokeViaResultPayload": {
      "title": "AdminRPCRevokeViaResultPayload",
      "description": "Sent only after every revocation is durable and every bound live stream has been closed. deviceIds is empty when no device was bound to appOrigin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["appOrigin", "deviceIds", "closedStreams"],
      "properties": {
        "appOrigin": { "$ref": "#/$defs/appOrigin" },
        "deviceIds": { "type": "array", "maxItems": 200, "items": { "$ref": "broker-rpc.schema.json#/$defs/uuid" } },
        "closedStreams": { "type": "integer", "minimum": 0, "maximum": 65536 }
      }
    },
    "computer": {
      "title": "AdminRPCComputer",
      "description": "One confirmed computer in one device's list on this (home) computer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "origin", "label", "createdAt"],
      "properties": {
        "deviceId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "origin": { "$ref": "http-api.schema.json#/$defs/computerOrigin" },
        "label": { "$ref": "http-api.schema.json#/$defs/computerLabel" },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "computerListResultPayload": {
      "title": "AdminRPCComputerListResultPayload",
      "description": "Confirmed computers of every device (at most 64 devices with 8 each). Pending entries are never listed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["computers"],
      "properties": {
        "computers": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/computer" } }
      }
    },
    "computerRemovePayload": {
      "title": "AdminRPCComputerRemovePayload",
      "description": "pterm computers remove: removes origin from every device's list, pending or confirmed. It cannot log the phone out on that computer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": { "origin": { "$ref": "http-api.schema.json#/$defs/computerOrigin" } }
    },
    "computerRemoveResultPayload": {
      "title": "AdminRPCComputerRemoveResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "removed"],
      "properties": {
        "origin": { "$ref": "http-api.schema.json#/$defs/computerOrigin" },
        "removed": { "type": "integer", "minimum": 0, "maximum": 200 }
      }
    },
    "projectAddPayload": {
      "title": "AdminRPCProjectAddPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/localPath" },
        "name": { "$ref": "#/$defs/displayName" }
      }
    },
    "project": {
      "title": "AdminRPCProject",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path"],
      "properties": {
        "id": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "name": { "$ref": "#/$defs/displayName" },
        "path": { "$ref": "#/$defs/localPath" }
      }
    },
    "projectResultPayload": {
      "title": "AdminRPCProjectResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": { "project": { "$ref": "#/$defs/project" } }
    },
    "projectListResultPayload": {
      "title": "AdminRPCProjectListResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/project" } }
      }
    },
    "profile": {
      "title": "AdminRPCShellProfile",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "executable", "arguments"],
      "properties": {
        "id": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "name": { "$ref": "#/$defs/displayName" },
        "executable": { "$ref": "#/$defs/localPath" },
        "arguments": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 256 } }
      }
    },
    "profileListResultPayload": {
      "title": "AdminRPCProfileListResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/profile" } }
      }
    },
    "originPayload": {
      "title": "AdminRPCOriginPayload",
      "description": "In a request, a present origin replaces the configured one and an absent origin reads it. In a result, origin is absent when none is configured.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "origin": { "$ref": "#/$defs/origin" } }
    },
    "shutdownResultPayload": {
      "title": "AdminRPCShutdownResultPayload",
      "description": "Sent after every live session was terminated through the normal termination path and before the broker stops serving.",
      "type": "object",
      "additionalProperties": false,
      "required": ["terminatedSessions"],
      "properties": { "terminatedSessions": { "type": "integer", "minimum": 0, "maximum": 64 } }
    },
    "emptyPayload": { "$ref": "broker-rpc.schema.json#/$defs/emptyPayload" },
    "pairGrantMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.grant" }, "payload": { "$ref": "#/$defs/pairGrantPayload" } } },
    "pairPendingMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.pending" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "pairApproveMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.approve" }, "payload": { "$ref": "#/$defs/pendingIdPayload" } } },
    "deviceListMessage": { "type": "object", "properties": { "type": { "const": "admin.device.list" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "deviceRevokeMessage": { "type": "object", "properties": { "type": { "const": "admin.device.revoke" }, "payload": { "$ref": "#/$defs/deviceIdPayload" } } },
    "deviceRenameMessage": { "type": "object", "properties": { "type": { "const": "admin.device.rename" }, "payload": { "$ref": "#/$defs/deviceRenamePayload" } } },
    "projectAddMessage": { "type": "object", "properties": { "type": { "const": "admin.project.add" }, "payload": { "$ref": "#/$defs/projectAddPayload" } } },
    "projectListMessage": { "type": "object", "properties": { "type": { "const": "admin.project.list" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "profileListMessage": { "type": "object", "properties": { "type": { "const": "admin.profile.list" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "profileDetectMessage": { "type": "object", "properties": { "type": { "const": "admin.profile.detect" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "configOriginMessage": { "type": "object", "properties": { "type": { "const": "admin.config.origin" }, "payload": { "$ref": "#/$defs/originPayload" } } },
    "shutdownMessage": { "type": "object", "properties": { "type": { "const": "admin.shutdown" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "gatewayStopMessage": { "type": "object", "properties": { "type": { "const": "admin.gateway.stop" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "deviceRevokeViaMessage": { "type": "object", "properties": { "type": { "const": "admin.device.revoke.via" }, "payload": { "$ref": "#/$defs/revokeViaPayload" } } },
    "computersListMessage": { "type": "object", "properties": { "type": { "const": "admin.computers.list" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "computersRemoveMessage": { "type": "object", "properties": { "type": { "const": "admin.computers.remove" }, "payload": { "$ref": "#/$defs/computerRemovePayload" } } },
    "pairOfferMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.offer" }, "payload": { "$ref": "#/$defs/pairOfferPayload" } } },
    "pairOfferEndMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.offer.end" }, "payload": { "$ref": "#/$defs/pairOfferEndPayload" } } },
    "pairGrantResultMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.grant.result" }, "payload": { "$ref": "#/$defs/pairGrantResultPayload" } } },
    "pairPendingResultMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.pending.result" }, "payload": { "$ref": "#/$defs/pairPendingResultPayload" } } },
    "pairApproveResultMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.approve.result" }, "payload": { "$ref": "#/$defs/pendingIdPayload" } } },
    "deviceListResultMessage": { "type": "object", "properties": { "type": { "const": "admin.device.list.result" }, "payload": { "$ref": "#/$defs/deviceListResultPayload" } } },
    "deviceRevokeResultMessage": { "type": "object", "properties": { "type": { "const": "admin.device.revoke.result" }, "payload": { "$ref": "#/$defs/deviceRevokeResultPayload" } } },
    "deviceRenameResultMessage": { "type": "object", "properties": { "type": { "const": "admin.device.rename.result" }, "payload": { "$ref": "#/$defs/deviceRenamePayload" } } },
    "projectAddResultMessage": { "type": "object", "properties": { "type": { "const": "admin.project.add.result" }, "payload": { "$ref": "#/$defs/projectResultPayload" } } },
    "projectListResultMessage": { "type": "object", "properties": { "type": { "const": "admin.project.list.result" }, "payload": { "$ref": "#/$defs/projectListResultPayload" } } },
    "profileListResultMessage": { "type": "object", "properties": { "type": { "const": "admin.profile.list.result" }, "payload": { "$ref": "#/$defs/profileListResultPayload" } } },
    "profileDetectResultMessage": { "type": "object", "properties": { "type": { "const": "admin.profile.detect.result" }, "payload": { "$ref": "#/$defs/profileListResultPayload" } } },
    "configOriginResultMessage": { "type": "object", "properties": { "type": { "const": "admin.config.origin.result" }, "payload": { "$ref": "#/$defs/originPayload" } } },
    "shutdownResultMessage": { "type": "object", "properties": { "type": { "const": "admin.shutdown.result" }, "payload": { "$ref": "#/$defs/shutdownResultPayload" } } },
    "gatewayStopResultMessage": { "type": "object", "properties": { "type": { "const": "admin.gateway.stop.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "deviceRevokeViaResultMessage": { "type": "object", "properties": { "type": { "const": "admin.device.revoke.via.result" }, "payload": { "$ref": "#/$defs/revokeViaResultPayload" } } },
    "computersListResultMessage": { "type": "object", "properties": { "type": { "const": "admin.computers.list.result" }, "payload": { "$ref": "#/$defs/computerListResultPayload" } } },
    "computersRemoveResultMessage": { "type": "object", "properties": { "type": { "const": "admin.computers.remove.result" }, "payload": { "$ref": "#/$defs/computerRemoveResultPayload" } } },
    "pairOfferResultMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.offer.result" }, "payload": { "$ref": "#/$defs/pairOfferResultPayload" } } },
    "pairOfferEndResultMessage": { "type": "object", "properties": { "type": { "const": "admin.pair.offer.end.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "errorMessage": { "type": "object", "properties": { "type": { "const": "admin.error" }, "payload": { "$ref": "broker-rpc.schema.json#/$defs/errorPayload" } } }
  }
}
