{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-terminal.invalid/protocol/v1/http-api.schema.json",
  "title": "HTTPAPIBody",
  "description": "Bounded JSON bodies of the same-origin browser HTTP API. See http-api.md for routes, headers and cookie rules.",
  "$defs": {
    "uuid": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 35 },
    "secret": {
      "description": "256-bit random value encoded as unpadded base64url (43 characters).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "deviceLabel": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "maxUtf8Bytes": 64, "safeDisplayText": true
    },
    "verificationCode": {
      "description": "Short human comparison code. It never authorizes access by itself.",
      "type": "string",
      "pattern": "^[0-9]{3}-[0-9]{3}$"
    },
    "pairRedeemRequest": {
      "title": "HTTPPairRedeemRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "deviceLabel"],
      "properties": {
        "grant": { "$ref": "#/$defs/secret" },
        "deviceLabel": { "$ref": "#/$defs/deviceLabel" }
      }
    },
    "pairRedeemResponse": {
      "title": "HTTPPairRedeemResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingId", "pollSecret", "verificationCode", "expiresAt"],
      "properties": {
        "pendingId": { "$ref": "#/$defs/uuid" },
        "pollSecret": { "$ref": "#/$defs/secret" },
        "verificationCode": { "$ref": "#/$defs/verificationCode" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "pairPollRequest": {
      "title": "HTTPPairPollRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingId", "pollSecret"],
      "properties": {
        "pendingId": { "$ref": "#/$defs/uuid" },
        "pollSecret": { "$ref": "#/$defs/secret" }
      }
    },
    "pairPollStatus": {
      "title": "HTTPPairPollStatus",
      "type": "string",
      "enum": ["pending", "approved"]
    },
    "pairPollResponse": {
      "title": "HTTPPairPollResponse",
      "description": "An approved response is the only one that sets the session cookie.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/pairPollStatus" },
        "device": { "$ref": "#/$defs/deviceSummary" }
      }
    },
    "deviceSummary": {
      "title": "HTTPDeviceSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "label": { "$ref": "#/$defs/deviceLabel" }
      }
    },
    "namedOption": {
      "title": "HTTPNamedOption",
      "description": "A saved project or shell profile, selected by ID. Paths and executables are never sent to the browser.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "maxUtf8Bytes": 128, "safeDisplayText": true
        }
      }
    },
    "settingsResponse": {
      "title": "HTTPSettingsResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "projects", "shellProfiles", "hostBuild", "brokerGeneration", "protocolRevision", "minProtocolRevision"],
      "properties": {
        "device": { "$ref": "#/$defs/deviceSummary" },
        "projects": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/namedOption" } },
        "shellProfiles": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/namedOption" } },
        "hostBuild": { "type": "string", "minLength": 1, "maxLength": 128 },
        "brokerGeneration": { "$ref": "#/$defs/uuid" },
        "protocolRevision": { "$ref": "#/$defs/protocolRevision" },
        "minProtocolRevision": { "$ref": "#/$defs/protocolRevision" }
      }
    },
    "protocolRevision": {
      "description": "Additive revision of protocol v1 (protocol/v1/revision.json). On the settings response, protocolRevision is this computer's revision and minProtocolRevision the oldest app revision it still serves. See http-api.md, Protocol revision.",
      "type": "integer", "minimum": 1, "maximum": 1000000
    },
    "computerOrigin": {
      "description": "Canonical origin of a Termivoa computer: https, lowercase DNS host of at least two labels, default port (no explicit port), no trailing dot, path, user or query.",
      "type": "string", "minLength": 12, "maxLength": 261,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "computerLabel": {
      "description": "Display name of a computer on this phone, by default the first DNS label of its origin. Never identity.",
      "type": "string", "minLength": 1, "maxLength": 64,
      "maxUtf8Bytes": 64, "safeDisplayText": true
    },
    "computerState": {
      "title": "HTTPComputerState",
      "description": "pending: recorded before pairing with the peer so the app's CSP allows it; short expiry, shown nowhere. confirmed: the app read the peer's settings with the peer's own cookie.",
      "type": "string",
      "enum": ["pending", "confirmed"]
    },
    "tailnetNode": {
      "title": "TailnetNode",
      "description": "A Tailscale node from the computer's own tailscale status. id is the stable node ID. owner is the login name of a user-owned node and is absent for tagged nodes, which carry tags instead. Display and pinning data, never authentication.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "owner": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "maxUtf8Bytes": 256, "safeDisplayText": true
        },
        "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^tag:[!-~]{1,60}$" } }
      }
    },
    "computer": {
      "title": "HTTPComputer",
      "description": "A confirmed peer computer in the calling device's own list on this (home) computer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "label"],
      "properties": {
        "origin": { "$ref": "#/$defs/computerOrigin" },
        "label": { "$ref": "#/$defs/computerLabel" }
      }
    },
    "computerListResponse": {
      "title": "HTTPComputerListResponse",
      "description": "GET /api/v1/computers: the calling device's confirmed computers. Pending entries are never listed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["computers"],
      "properties": {
        "computers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/computer" } }
      }
    },
    "computerAddRequest": {
      "title": "HTTPComputerAddRequest",
      "description": "POST /api/v1/computers. state pending records or refreshes a short-lived pending entry before pairing; confirmed confirms an existing entry (or renames a confirmed one) after the peer's settings were read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "label", "state"],
      "properties": {
        "origin": { "$ref": "#/$defs/computerOrigin" },
        "label": { "$ref": "#/$defs/computerLabel" },
        "state": { "$ref": "#/$defs/computerState" }
      }
    },
    "computerAddResponse": {
      "title": "HTTPComputerAddResponse",
      "description": "The saved entry and the peer's node as seen in this computer's own tailscale status, for the app's confirm sheet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["computer", "state", "node"],
      "properties": {
        "computer": { "$ref": "#/$defs/computer" },
        "state": { "$ref": "#/$defs/computerState" },
        "node": { "$ref": "#/$defs/tailnetNode" }
      }
    },
    "sessionListResponse": {
      "title": "HTTPSessionListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": { "type": "array", "maxItems": 200, "items": { "$ref": "broker-rpc.schema.json#/$defs/sessionRecord" } }
      }
    },
    "sessionCreateRequest": {
      "title": "HTTPSessionCreateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "projectId", "shellProfileId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "shellProfileId": { "$ref": "#/$defs/uuid" },
        "worktree": { "$ref": "broker-rpc.schema.json#/$defs/worktreeCreate" }
      }
    },
    "sessionRenameRequest": {
      "title": "HTTPSessionRenameRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "generation", "title"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "broker-rpc.schema.json#/$defs/sessionRenameRequestPayload/properties/title" }
      }
    },
    "sessionTerminateRequest": {
      "title": "HTTPSessionTerminateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "generation"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/uuid" }
      }
    },
    "sessionMutationResponse": {
      "title": "HTTPSessionMutationResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "session"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "session": { "$ref": "broker-rpc.schema.json#/$defs/sessionRecord" }
      }
    },
    "deviceRenameRequest": {
      "title": "HTTPDeviceRenameRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/deviceLabel" }
      }
    },
    "pushPublicKey": {
      "description": "Uncompressed P-256 public key (65 bytes) as unpadded base64url.",
      "type": "string",
      "pattern": "^B[A-Za-z0-9_-]{86}$"
    },
    "pushEndpoint": {
      "description": "Push service URL from PushSubscription.endpoint. The broker accepts only https URLs on a known push service host.",
      "type": "string", "minLength": 12, "maxLength": 2048,
      "pattern": "^https://[!-~]+$"
    },
    "pushConfigResponse": {
      "title": "HTTPPushConfigResponse",
      "description": "The broker's VAPID application server public key.",
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey"],
      "properties": {
        "publicKey": { "$ref": "#/$defs/pushPublicKey" }
      }
    },
    "pushSubscriptionKeys": {
      "title": "HTTPPushSubscriptionKeys",
      "type": "object",
      "additionalProperties": false,
      "required": ["p256dh", "auth"],
      "properties": {
        "p256dh": { "$ref": "#/$defs/pushPublicKey" },
        "auth": {
          "$comment": "16-byte push authentication secret as unpadded base64url.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      }
    },
    "pushSubscribeRequest": {
      "title": "HTTPPushSubscribeRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "keys"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/pushEndpoint" },
        "keys": { "$ref": "#/$defs/pushSubscriptionKeys" }
      }
    },
    "pushUnsubscribeRequest": {
      "title": "HTTPPushUnsubscribeRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/pushEndpoint" }
      }
    },
    "previewConfigResponse": {
      "title": "HTTPPreviewConfigResponse",
      "description": "GET /api/v1/preview. origin is the separate preview origin that the phone app may frame (for example https://host:8443); it is absent when the gateway serves no previews.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 8, "maxLength": 512, "pattern": "^https?://[^/?#@\\s]+$" }
      }
    },
    "pushTestResponse": {
      "title": "HTTPPushTestResponse",
      "description": "How many of the calling device's subscriptions accepted the test notification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sent"],
      "properties": {
        "sent": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "uploadContentType": {
      "title": "HTTPUploadContentType",
      "description": "Image type detected by the broker from the file's magic bytes. The client never names it.",
      "type": "string",
      "enum": ["image/jpeg", "image/png", "image/webp", "image/gif"]
    },
    "uploadRequest": {
      "title": "HTTPUploadRequest",
      "description": "One image for the session's project folder. data is the file, standard padded base64, 1 byte to 5 MiB decoded. The client name is never sent: the broker names the file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "data"],
      "properties": {
        "generation": { "$ref": "#/$defs/uuid" },
        "data": { "type": "string", "minLength": 4, "maxLength": 6990508, "contentEncoding": "base64" }
      }
    },
    "uploadResponse": {
      "title": "HTTPUploadResponse",
      "description": "Where the broker saved the image, relative to the session's project folder.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "contentType"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.termivoa/uploads/[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\\.(jpg|png|webp|gif)$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "contentType": { "$ref": "#/$defs/uploadContentType" }
      }
    },
    "errorResponse": {
      "title": "HTTPErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "$ref": "broker-rpc.schema.json#/$defs/errorPayload" }
      }
    }
  }
}
