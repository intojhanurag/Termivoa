{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-terminal.invalid/protocol/v1/gateway-rpc.schema.json",
  "title": "GatewayRPCMessage",
  "description": "Bounded correlated RPC between the browser gateway and the broker on an IPC connection whose peer declared clientKind gateway. Every authenticated request carries the raw browser credential; the broker hashes and re-authorizes it for each request. See authentication-rpc.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "requestId", "payload"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "type": { "$ref": "#/$defs/messageType" },
    "requestId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/pairRedeemMessage" },
    { "$ref": "#/$defs/pairPollMessage" },
    { "$ref": "#/$defs/authCheckMessage" },
    { "$ref": "#/$defs/authLogoutMessage" },
    { "$ref": "#/$defs/settingsMessage" },
    { "$ref": "#/$defs/sessionListMessage" },
    { "$ref": "#/$defs/sessionCreateMessage" },
    { "$ref": "#/$defs/sessionRenameMessage" },
    { "$ref": "#/$defs/sessionTerminateMessage" },
    { "$ref": "#/$defs/liveOpenMessage" },
    { "$ref": "#/$defs/originMessage" },
    { "$ref": "#/$defs/deviceRenameMessage" },
    { "$ref": "#/$defs/pushConfigMessage" },
    { "$ref": "#/$defs/pushSubscribeMessage" },
    { "$ref": "#/$defs/pushUnsubscribeMessage" },
    { "$ref": "#/$defs/pushTestMessage" },
    { "$ref": "#/$defs/pairRedeemResultMessage" },
    { "$ref": "#/$defs/pairPollResultMessage" },
    { "$ref": "#/$defs/authCheckResultMessage" },
    { "$ref": "#/$defs/authLogoutResultMessage" },
    { "$ref": "#/$defs/settingsResultMessage" },
    { "$ref": "#/$defs/sessionListResultMessage" },
    { "$ref": "#/$defs/sessionCreateResultMessage" },
    { "$ref": "#/$defs/sessionRenameResultMessage" },
    { "$ref": "#/$defs/sessionTerminateResultMessage" },
    { "$ref": "#/$defs/liveOpenResultMessage" },
    { "$ref": "#/$defs/originResultMessage" },
    { "$ref": "#/$defs/deviceRenameResultMessage" },
    { "$ref": "#/$defs/pushConfigResultMessage" },
    { "$ref": "#/$defs/pushSubscribeResultMessage" },
    { "$ref": "#/$defs/pushUnsubscribeResultMessage" },
    { "$ref": "#/$defs/pushTestResultMessage" },
    { "$ref": "#/$defs/errorMessage" }
  ],
  "$defs": {
    "messageType": {
      "title": "GatewayRPCMessageType",
      "type": "string",
      "enum": [
        "gateway.pair.redeem", "gateway.pair.poll", "gateway.auth.check", "gateway.auth.logout",
        "gateway.settings", "gateway.session.list", "gateway.session.create", "gateway.session.rename",
        "gateway.session.terminate", "gateway.live.open", "gateway.origin", "gateway.device.rename",
        "gateway.push.config", "gateway.push.subscribe", "gateway.push.unsubscribe", "gateway.push.test",
        "gateway.pair.redeem.result", "gateway.pair.poll.result", "gateway.auth.check.result",
        "gateway.auth.logout.result", "gateway.settings.result", "gateway.session.list.result",
        "gateway.session.create.result", "gateway.session.rename.result",
        "gateway.session.terminate.result", "gateway.live.open.result", "gateway.origin.result",
        "gateway.device.rename.result", "gateway.push.config.result", "gateway.push.subscribe.result",
        "gateway.push.unsubscribe.result", "gateway.push.test.result", "gateway.error"
      ]
    },
    "credentialPayload": {
      "title": "GatewayRPCCredentialPayload",
      "description": "The raw browser cookie value. It is never logged, persisted, or echoed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" }
      }
    },
    "sessionCreatePayload": {
      "title": "GatewayRPCSessionCreatePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "request": { "$ref": "http-api.schema.json#/$defs/sessionCreateRequest" }
      }
    },
    "sessionRenamePayload": {
      "title": "GatewayRPCSessionRenamePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "sessionId", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "sessionId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "request": { "$ref": "http-api.schema.json#/$defs/sessionRenameRequest" }
      }
    },
    "sessionTerminatePayload": {
      "title": "GatewayRPCSessionTerminatePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "sessionId", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "sessionId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "request": { "$ref": "http-api.schema.json#/$defs/sessionTerminateRequest" }
      }
    },
    "deviceRenamePayload": {
      "title": "GatewayRPCDeviceRenamePayload",
      "description": "Renames only the device that owns the credential.",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "request": { "$ref": "http-api.schema.json#/$defs/deviceRenameRequest" }
      }
    },
    "pushSubscribePayload": {
      "title": "GatewayRPCPushSubscribePayload",
      "description": "Saves a push subscription for the device that owns the credential.",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "request": { "$ref": "http-api.schema.json#/$defs/pushSubscribeRequest" }
      }
    },
    "pushUnsubscribePayload": {
      "title": "GatewayRPCPushUnsubscribePayload",
      "description": "Removes one push subscription of the device that owns the credential.",
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "request"],
      "properties": {
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "request": { "$ref": "http-api.schema.json#/$defs/pushUnsubscribeRequest" }
      }
    },
    "originResultPayload": {
      "title": "GatewayRPCOriginResultPayload",
      "description": "The browser origin configured with admin.config.origin, absent when none is set. It is not a secret. The gateway adds it to its exact Host and Origin allow-list when it is valid for the gateway's profile.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "$ref": "admin-rpc.schema.json#/$defs/origin" }
      }
    },
    "pairPollResultPayload": {
      "title": "GatewayRPCPairPollResultPayload",
      "description": "credential and credentialExpiresAt appear exactly when response.status is approved. That single response is the only delivery of the credential; it is never replayable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["response"],
      "properties": {
        "response": { "$ref": "http-api.schema.json#/$defs/pairPollResponse" },
        "credential": { "$ref": "http-api.schema.json#/$defs/secret" },
        "credentialExpiresAt": { "$ref": "http-api.schema.json#/$defs/timestamp" }
      }
    },
    "principalPayload": {
      "title": "GatewayRPCPrincipalPayload",
      "description": "Broker-resolved identity for one valid credential. Display and routing data only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "deviceLabel", "credentialId", "expiresAt"],
      "properties": {
        "deviceId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "deviceLabel": { "$ref": "http-api.schema.json#/$defs/deviceLabel" },
        "credentialId": { "$ref": "broker-rpc.schema.json#/$defs/uuid" },
        "expiresAt": { "$ref": "http-api.schema.json#/$defs/timestamp" }
      }
    },
    "emptyPayload": { "$ref": "broker-rpc.schema.json#/$defs/emptyPayload" },
    "pairRedeemMessage": { "type": "object", "properties": { "type": { "const": "gateway.pair.redeem" }, "payload": { "$ref": "http-api.schema.json#/$defs/pairRedeemRequest" } } },
    "pairPollMessage": { "type": "object", "properties": { "type": { "const": "gateway.pair.poll" }, "payload": { "$ref": "http-api.schema.json#/$defs/pairPollRequest" } } },
    "authCheckMessage": { "type": "object", "properties": { "type": { "const": "gateway.auth.check" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "authLogoutMessage": { "type": "object", "properties": { "type": { "const": "gateway.auth.logout" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "settingsMessage": { "type": "object", "properties": { "type": { "const": "gateway.settings" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "sessionListMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.list" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "sessionCreateMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.create" }, "payload": { "$ref": "#/$defs/sessionCreatePayload" } } },
    "sessionRenameMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.rename" }, "payload": { "$ref": "#/$defs/sessionRenamePayload" } } },
    "sessionTerminateMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.terminate" }, "payload": { "$ref": "#/$defs/sessionTerminatePayload" } } },
    "liveOpenMessage": { "type": "object", "properties": { "type": { "const": "gateway.live.open" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "originMessage": { "type": "object", "properties": { "type": { "const": "gateway.origin" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "deviceRenameMessage": { "type": "object", "properties": { "type": { "const": "gateway.device.rename" }, "payload": { "$ref": "#/$defs/deviceRenamePayload" } } },
    "pushConfigMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.config" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "pushSubscribeMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.subscribe" }, "payload": { "$ref": "#/$defs/pushSubscribePayload" } } },
    "pushUnsubscribeMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.unsubscribe" }, "payload": { "$ref": "#/$defs/pushUnsubscribePayload" } } },
    "pushTestMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.test" }, "payload": { "$ref": "#/$defs/credentialPayload" } } },
    "pairRedeemResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.pair.redeem.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/pairRedeemResponse" } } },
    "pairPollResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.pair.poll.result" }, "payload": { "$ref": "#/$defs/pairPollResultPayload" } } },
    "authCheckResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.auth.check.result" }, "payload": { "$ref": "#/$defs/principalPayload" } } },
    "authLogoutResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.auth.logout.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "settingsResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.settings.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/settingsResponse" } } },
    "sessionListResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.list.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/sessionListResponse" } } },
    "sessionCreateResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.create.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/sessionMutationResponse" } } },
    "sessionRenameResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.rename.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/sessionMutationResponse" } } },
    "sessionTerminateResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.session.terminate.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/sessionMutationResponse" } } },
    "liveOpenResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.live.open.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "originResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.origin.result" }, "payload": { "$ref": "#/$defs/originResultPayload" } } },
    "deviceRenameResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.device.rename.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/deviceSummary" } } },
    "pushConfigResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.config.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/pushConfigResponse" } } },
    "pushSubscribeResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.subscribe.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "pushUnsubscribeResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.unsubscribe.result" }, "payload": { "$ref": "#/$defs/emptyPayload" } } },
    "pushTestResultMessage": { "type": "object", "properties": { "type": { "const": "gateway.push.test.result" }, "payload": { "$ref": "http-api.schema.json#/$defs/pushTestResponse" } } },
    "errorMessage": { "type": "object", "properties": { "type": { "const": "gateway.error" }, "payload": { "$ref": "broker-rpc.schema.json#/$defs/errorPayload" } } }
  }
}
