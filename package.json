{
  "name": "phone-terminal-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.11.0"
  },
  "scripts": {
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "pnpm protocol:generate && git diff --exit-code -- internal/protocol/generated.go web/src/generated/protocol.ts",
    "typecheck": "pnpm --filter @phone-terminal/web typecheck",
    "test:web": "pnpm --filter @phone-terminal/web test",
    "build:web": "pnpm --filter @phone-terminal/web build"
  },
  "devDependencies": {
    "quicktype": "26.0.0"
  }
}
